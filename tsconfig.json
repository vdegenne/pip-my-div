{
	"compilerOptions": {
		"module": "esnext",
		"target": "esnext",
		"moduleResolution": "node",
		"strict": true,
		"useDefineForClassFields": false,
		"experimentalDecorators": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"outDir": "./lib",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"types": ["html2canvas"]
	},
	"include": ["./src/**/*.ts", "./types.d.ts"]
}
